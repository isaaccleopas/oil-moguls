<!DOCTYPE html>
<html lang="en" data-theme="oil-moguls">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Oil Moguls is a learning community for oil and gas professionals, not an oil and gas company. Academy, ApexBee, mentorship, and verified opportunity for students through regulators."
    />
    <meta property="og:title" content="Oil Moguls" />
    <meta
      property="og:description"
      content="The learning community for oil and gas professionals. Not an oil company. Access is earned. We make sure it's possible."
    />
    <meta property="og:type" content="website" />
    <.live_title default="Home" suffix=" · Oil Moguls">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-offwhite font-sans text-night antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-forest focus:px-4 focus:py-2 focus:text-offwhite"
    >
      Skip to content
    </a>
    {@inner_content}
  </body>
</html>
